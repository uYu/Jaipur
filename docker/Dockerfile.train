FROM node:22-bookworm-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv
ARG TORCH_VERSION=2.14.0
RUN pip install --no-cache-dir "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "numpy>=2,<3" "swanlab==0.10.1"
COPY src/game/ ./src/game/
COPY scripts/train-information-model.py scripts/train-information-ppo.py \
     scripts/collect-information.ts scripts/run-information-swanlab.py \
     scripts/verify-information-continuation.ts scripts/train-container.py ./scripts/
COPY package.json ./
ENTRYPOINT ["python", "scripts/train-container.py"]
