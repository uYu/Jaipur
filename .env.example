# Web app (docker compose up -d --build)
JAIPUR_PORT=8204

# PPO training (docker compose --profile train up --build train)
# Additional matches per invocation. Must be a positive multiple of 32.
TRAIN_GAMES=32768
TRAIN_THREADS=4
TRAIN_OUTPUT_DIR=./training-runs
TRAIN_SEED_BASE=500000
TRAIN_RANDOM_SEED=9241
# auto: resume latest checkpoint, or start from random weights if none exists.
# none: always start a new random model. A run directory name selects a checkpoint.
TRAIN_RESUME=auto
# auto: enable online logs only if SWANLAB_API_KEY is present. on / off are also supported.
TRAIN_SWANLAB=auto
SWANLAB_API_KEY=
# Decouple opponent selection from seat; keep 0 only for reproducing old experiments.
INFORMATION_BALANCED_SEATS=1
